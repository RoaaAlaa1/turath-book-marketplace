<div class="container mt-4">
    <h2>تتبع طلباتي وسجل الطلبات</h2>
    <div id="orders-container" class="row">
        <!-- سيتم تعبئة الطلبات هنا تلقائياً -->
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document.ready = function () {
        loadCustomerOrders();
    });

    function loadCustomerOrders() {
        $.ajax({
            url: '/api/Orders/customer/1', // معرف العميل الافتراضي
            type: 'GET',
            success: function (orders) {
                let container = $('#orders-container');
                container.empty();

                if (orders.length === 0) {
                    container.append('<p>لا توجد طلبات سابقة.</p>');
                    return;
                }

                orders.forEach(order => {
                    // التحقق من حالة الطلب لعرض زر الإلغاء فقط لو كان Pending
                    let canCancel = order.status === 'Pending';
                    let cancelBtnHtml = canCancel 
                        ? `<button class="btn btn-danger btn-sm" onclick="cancelOrder('${order.id}')">إلغاء الطلب</button>` 
                        : `<span class="text-muted">لا يمكن إلغاؤه</span>`;

                    let card = `
                        <div class="col-md-6 mb-3">
                            <div class="card p-3 shadow-sm">
                                <h5>رقم الطلب: ${order.id}</h5>
                                <p>تاريخ الطلب: ${new Date(order.createdAt).toLocaleString()}</p>
                                <p>الإجمالي: <strong>$${order.total.toFixed(2)}</strong></p>
                                <p>الحالة الحالية: <span class="badge bg-secondary">${order.status}</span></p>
                                <div>${cancelBtnHtml}</div>
                            </div>
                        </div>
                    `;
                    container.append(card);
                });
            },
            error: function () {
                alert('فشل في جلب سجل الطلبات');
            }
        });
    }

    function cancelOrder(orderId) {
        if (!confirm("هل أنت متأكد من رغبتك في إلغاء هذا الطلب؟")) return;

        $.ajax({
            url: '/api/Orders/update-status',
            type: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify({
                orderId: orderId,
                status: 'Cancelled'
            }),
            success: function () {
                alert("تم إلغاء الطلب بنجاح");
                loadCustomerOrders(); // تحديث القائمة فوراً
            },
            error: function () {
                alert("فشل تحديث حالة الطلب");
            }
        });
    }
</script>